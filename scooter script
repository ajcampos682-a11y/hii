local function pivotOf(inst)
  if not inst then return nil end
  if inst:IsA("Model") or inst:IsA("BasePart") then return inst:GetPivot() end
  local p=inst:FindFirstChildWhichIsA("BasePart",true)
  return p and p.CFrame or nil
end
local function tp(cf) local c=char() if c and cf then c:PivotTo(cf) return true end return false end
