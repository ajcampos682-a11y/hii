-- ============ steal ============
local function crates()
  local t={} local r=root() local folder=workspace:FindFirstChild("NestEggs")
  if not (r and folder) then return t end
  for _,e in ipairs(folder:GetChildren()) do
    local er=e:FindFirstChild("Root")
    if er and e:FindFirstChild("StealPrompt",true) and rank(e:GetAttribute("Rarity"))>=S.minRank then
      t[#t+1]={e=e,rk=rank(e:GetAttribute("Rarity")),d=(er.Position-r.Position).Magnitude}
    end
  end
  table.sort(t,function(a,b) if a.rk~=b.rk then return a.rk>b.rk end return a.d<b.d end)
  return t
end
local function stealOne(e)
  local er=e:FindFirstChild("Root") local p=e:FindFirstChild("StealPrompt",true)
  if not (er and p and root()) then return false end
  say("Going to "..e.Name.." ["..tostring(e:GetAttribute("Rarity")).."]")
  tp(er.CFrame+Vector3.new(0,4,0))
  task.wait(0.4)
  if not e.Parent then return false end
  prompt(p)
  local t0=os.clock()
  while alive and os.clock()-t0<3 and LP:GetAttribute("CarryingEgg")~=true do task.wait(0.1) end
  if LP:GetAttribute("CarryingEgg")~=true then say("Steal not accepted: "..e.Name) return false end
  say("Carrying "..e.Name..", returning")
  goHome()
  t0=os.clock()
  while alive and os.clock()-t0<8 and LP:GetAttribute("CarryingEgg")==true do task.wait(0.2) end
  say(LP:GetAttribute("CarryingEgg")==true and "Still carrying after return" or ("Delivered "..e.Name))
  return true
end
task.spawn(function()
