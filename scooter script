  local plots=workspace:FindFirstChild("Plots")
  for i=1,5 do local p=plots and plots:FindFirstChild(tostring(i)) if p then tpBtn("Plot "..i,p:FindFirstChild("SpawnPoint") or p:FindFirstChild("CenterPoint") or p) end end
  local shops=workspace:FindFirstChild("Shops")
  for _,s in ipairs(shops and shops:GetChildren() or {}) do tpBtn("Shop: "..s.Name,s) end
  for _,n in ipairs({"BlackMarket","RadioactiveCloudLobby","FlyingScooterStand","InvincibleScooterStand","EventBoard","World2","SpawnLocation"}) do
    local inst=workspace:FindFirstChild(n) if inst then tpBtn(n,inst) end
  end
end

-- Events
local pEv=addTab("Events")
toggle(pEv,"Auto claim gift / index / fuse / frost","autoClaim")
toggle(pEv,"Auto join races","autoRace")
toggle(pEv,"Collect wing and frost pickups","pickups")
button(pEv,"Claim everything now",function() fire("GiftAction","Claim") fire("IndexAction","ClaimAll") fire("FuseAction","Collect") fire("FrostAction","ClaimLogin") fire("FrostAction","ClaimAll") end)
button(pEv,"RSVP to event",function() fire("EventRSVP") end)

-- Settings
local pSet=addTab("Settings")
slider(pSet,"Transparency","alpha",0,0.9,0.05,function(v) for _,f in ipairs(tinted) do f.BackgroundTransparency=v end end)
do local f=row(pSet) text(f,"Made "..BUILD.date.." with Claude",12,UDim2.new(1,-24,0,34)).TextColor3=C.dim end
do local f=row(pSet) text(f,"Measured on game build v"..BUILD.version.."; this server is v"..game.PlaceVersion,12,UDim2.new(1,-24,0,34)).TextColor3=C.dim end

do
  local name="unknown" if identifyexecutor then local ok,n=pcall(identifyexecutor) if ok and n then name=tostring(n) end end
  local f=row(pSet) text(f,"Executor: "..name.."  |  prompts: "..(fireproximityprompt and "native" or "fallback").."  |  touch: "..(firetouchinterest and "native" or "fallback"),12,UDim2.new(1,-24,0,34)).TextColor3=C.dim
end
local function Unload()
  alive=false
  for _,r in ipairs(resets) do pcall(r) end
  for _,c in ipairs(conns) do c:Disconnect() end
  local h=hum() if h then h.WalkSpeed=LP:GetAttribute("WalkSpeed") or 16 end
  gui:Destroy()
  env.ClaudeHub=nil
end
button(pSet,"Unload",function() Unload() end)

-- window drag + hide
do
  local drag,startPos,startInput
  on(top.InputBegan,function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then drag=true startPos=main.Position startInput=i.Position end end)
  on(UIS.InputChanged,function(i) if drag and (i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch) then local d=i.Position-startInput main.Position=UDim2.new(startPos.X.Scale,startPos.X.Offset+d.X,startPos.Y.Scale,startPos.Y.Offset+d.Y) end end)
  on(UIS.InputEnded,function(i) if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then drag=false end end)
end
on(close.MouseButton1Click,function() main.Visible=false end)
local fab=new("TextButton",{Size=UDim2.fromOffset(46,46),Position=UDim2.new(0.5,-23,0,8),BackgroundColor3=C.bg,Text="C",TextColor3=C.accent,Font=Enum.Font.GothamBold,TextSize=22,AutoButtonColor=false,BorderSizePixel=0},gui) corner(fab,23)
new("UIStroke",{Color=C.accent,Thickness=1.5},fab)
on(fab.MouseButton1Click,function() main.Visible=not main.Visible end)
on(UIS.InputBegan,function(i,gp) if not gp and i.KeyCode==Enum.KeyCode.RightShift then main.Visible=not main.Visible end end)

selectTab("Farm")
env.ClaudeHub={Unload=Unload,State=S,Build=BUILD}
return "loaded"
