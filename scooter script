local function prompt(p)
  if not (p and p:IsA("ProximityPrompt")) then return false end
  if fireproximityprompt then
    local hold=p.HoldDuration p.HoldDuration=0
    local ok=pcall(fireproximityprompt,p)
    p.HoldDuration=hold
    if ok then return true end
  end
  return (pcall(function() p:InputHoldBegin() task.wait(p.HoldDuration+0.1) p:InputHoldEnd() end))
end

